# Copie para .env e preencha. O arquivo .env real está no .gitignore.

# ---------------------------------------------------------------------------
# BrowserStack App Automate (opcional — apenas para npm run test:browserstack)
# ---------------------------------------------------------------------------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# ID retornado pelo upload do app: bs://<hash>  (npm run app:upload)
BROWSERSTACK_APP_ID=
BROWSERSTACK_PROJECT_NAME=native-demo-app
BROWSERSTACK_BUILD_NAME=
BROWSERSTACK_LOCAL=false

# ---------------------------------------------------------------------------
# Execução local — Android
# ---------------------------------------------------------------------------
# Caminho do APK (se ausente, usa o binário em apps/android)
ANDROID_APP_PATH=
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
# Nome do AVD; quando definido, o Appium sobe o emulador automaticamente
ANDROID_AVD=

# ---------------------------------------------------------------------------
# Execução local — iOS (somente macOS com Xcode)
# ---------------------------------------------------------------------------
IOS_APP_PATH=
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=
IOS_UDID=

# ---------------------------------------------------------------------------
# Appium / execução
# ---------------------------------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
WDIO_LOG_LEVEL=warn
WAIT_TIMEOUT=15000
SUBMIT_TIMEOUT=20000
MOCHA_TIMEOUT=120000
TEST_ENV=Local
