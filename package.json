{
  "name": "mobile-automation-native-demo-app",
  "version": "1.0.0",
  "description": "Suite de automacao mobile (Android/iOS) do WebdriverIO native-demo-app com Appium, Mocha, Chai, Page Object Model, Allure e BrowserStack",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "echo \"Use: npm run test:android | npm run test:ios | npm run test:browserstack\" && exit 1",
    "app:download": "node scripts/download-app.mjs",
    "validate:selectors": "node scripts/validate-pageobjects.mjs",
    "validate:specs": "mocha --dry-run --reporter spec --require ./scripts/mocha-globals-stub.js \"test/specs/**/*.spec.js\"",
    "test:android": "wdio run config/wdio.android.conf.js",
    "test:ios": "wdio run config/wdio.ios.conf.js",
    "validate:configs": "node scripts/validate-configs.mjs",
    "report:clean": "node -e \"const fs=require('node:fs');for(const d of ['allure-results','allure-report'])fs.rmSync(d,{recursive:true,force:true})\"",
    "report:generate": "allure generate allure-results --clean --output allure-report",
    "report:open": "allure open allure-report",
    "test:browserstack": "wdio run config/wdio.browserstack.conf.js",
    "app:upload": "node scripts/upload-browserstack.mjs"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mobile",
    "android",
    "ios",
    "mocha",
    "chai",
    "allure",
    "browserstack",
    "qa-automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.31.5",
    "@wdio/browserstack-service": "^9.35.2",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "appium": "^3.7.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "mocha": "^12.0.0",
    "webdriverio": "^9.31.5"
  }
}
